{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "firestore.indexes.json",
      "**/.*",
      "**/.*/**",
      ".git/**",
      "**/node_modules/**",
      "**/*firebase-adminsdk*.json",
      "serviceAccountKey*.json",
      "scripts/**",
      "examples/**",
      "data/**"
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "eur3",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
